root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{png,jpg,jpeg,gif,ico,svg,woff,woff2,ttf,eot,otf,mp4,webm,ogg,mp3,flac,wav,zip,tar,gz,7z,bz2,xz,pdf,bin,exe,dll,so,dylib}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
